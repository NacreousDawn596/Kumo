# Kumo environment configuration.
# Copy to .env and fill in production values. Never commit .env.

# Core
ENVIRONMENT=development
DEBUG=false
PUBLIC_BASE_URL=http://localhost:5480
FRONTEND_ORIGIN=http://localhost:5480
ALLOWED_ORIGINS=http://localhost:5480

# Database — PostgreSQL (production). For local dev you may use SQLite:
#   DATABASE_URL=sqlite:///./data/kumo.db
DATABASE_URL=postgresql://kumo:kumo@localhost:5432/kumo
POSTGRES_PASSWORD=kumo

# Storage (binary file contents)
STORAGE_PATH=./data/storage

# Security — a long random string. Generate: openssl rand -hex 32
SECRET_KEY=
SESSION_TTL_SECONDS=2592000
ACCESS_TOKEN_TTL_SECONDS=900

# Cookies (set COOKIE_SECURE=true behind HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Auth provider: "local" or "schoolapp"
AUTH_PROVIDER=schoolapp

# Shared HMAC secret with the SchoolApp Cloudflare Worker (identity verification).
# Must match the worker's SCHOOLAPP_WORKER_SECRET. Generate: openssl rand -hex 32
SCHOOLAPP_WORKER_SECRET=
SCHOOLAPP_WORKER_ISSUER=schoolapp-worker
SCHOOLAPP_WORKER_AUDIENCE=kumo

# Public URL of the SchoolApp identity worker (baked into the frontend at build time).
VITE_SCHOOLAPP_WORKER_URL=https://schoolapp-worker.nacreousdawn596.workers.dev

# Web Push (VAPID). Generate with:
#   python -c "from py_vapid import Vapid01; print(Vapid01().generate())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kumo.example.com

# LiveKit SFU (group audio). Rendered into infra/livekit.yaml by ./scripts/setup.sh.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# TURN relay (WebRTC behind restrictive NATs). Rendered into infra/turnserver.conf by ./scripts/setup.sh.
TURN_URIS=
TURN_USERNAME=kumo
TURN_CREDENTIAL=

# Limits
MAX_UPLOAD_BYTES=52428800
DEFAULT_STORAGE_QUOTA_BYTES=524288000
