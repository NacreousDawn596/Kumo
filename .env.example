# Kumo environment configuration.
# Copy to .env and fill in production values. Never commit .env.

# Core
ENVIRONMENT=development
DEBUG=false
PUBLIC_BASE_URL=http://localhost:5480
FRONTEND_ORIGIN=http://localhost:5480
ALLOWED_ORIGINS=http://localhost:5480

# Database (SQLite file path, relative to backend working directory)
DATABASE_URL=sqlite:///./data/kumo.db

# Storage (binary file contents)
STORAGE_PATH=./data/storage

# Security — REPLACE in production with a long random string.
# Generate: openssl rand -hex 32
SECRET_KEY=change-me-in-production
SESSION_TTL_SECONDS=2592000
ACCESS_TOKEN_TTL_SECONDS=900

# Cookies (set COOKIE_SECURE=true behind HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Auth provider: "local" (dev) or "schoolapp"
AUTH_PROVIDER=local

# SchoolApp (documented scaffold — supply provider endpoints when available)
SCHOOLAPP_ISSUER=
SCHOOLAPP_CLIENT_ID=
SCHOOLAPP_CLIENT_SECRET=
SCHOOLAPP_AUTHORIZE_URL=
SCHOOLAPP_TOKEN_URL=
SCHOOLAPP_JWKS_URL=
SCHOOLAPP_AUDIENCE=

# Shared HMAC secret with the SchoolApp Cloudflare Worker (identity verification).
# Must match the worker's SCHOOLAPP_WORKER_SECRET. Generate: openssl rand -hex 32
SCHOOLAPP_WORKER_SECRET=
SCHOOLAPP_WORKER_ISSUER=schoolapp-worker
SCHOOLAPP_WORKER_AUDIENCE=kumo

# Limits
MAX_UPLOAD_BYTES=52428800
DEFAULT_STORAGE_QUOTA_BYTES=1073741824
