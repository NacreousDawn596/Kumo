# LiveKit server configuration (group audio SFU).
# This is a TEMPLATE — do NOT commit real keys here.
# Generate the live file (infra/livekit.yaml) from your .env with:
#   ./scripts/setup.sh
# See https://docs.livekit.io for full options.
port: 7880
rtc:
  tcp_port: 7881
  port_range_start: 7882
  port_range_end: 7890
  use_external_ip: false
keys:
  ${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}
